# Public client config
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GEMINI_API_KEY=your_gemini_api_key

# Password-only auth for the 2 fixed accounts
PAIR_MEMBER_ONE_PASSWORD=your_first_member_password
PAIR_MEMBER_TWO_PASSWORD=your_second_member_password
APP_SESSION_SECRET=replace_with_a_long_random_string

# App config
PAIR_TIMEZONE=Asia/Ho_Chi_Minh
GEMINI_MODEL=gemini-2.5-flash-lite
CRON_SECRET=replace_with_a_long_random_string
